# Neon: pooled connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"
# Neon: direct connection string (used by prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"
# Admin login
ADMIN_PASSWORD="change-me"
# Random string, e.g. `openssl rand -hex 32`
AUTH_SECRET="change-me-too"
# Claude API key for the site chatbot (console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."
